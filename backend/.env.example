PIOS_ENV=development
PIOS_API_PREFIX=/api/v1
PIOS_DATABASE_URL=postgresql+psycopg://pios:pios@db:5432/pios
PIOS_ORGANIZATION_CODE=NBC
PIOS_DEFAULT_SITE_CODE=TGH
PIOS_LOG_LEVEL=INFO
PIOS_AUTH_MODE=dev
PIOS_ALLOW_DEV_TOKENS=true
PIOS_OIDC_ISSUER=
PIOS_OIDC_AUDIENCE=pios-api
PIOS_OIDC_JWKS_URL=
PIOS_OIDC_ROLES_CLAIM=roles
PIOS_OIDC_SITE_CLAIM=sites
PIOS_CORS_ORIGINS=http://localhost:8080,http://localhost:5173
PIOS_OBJECT_STORAGE_BACKEND=s3
PIOS_OBJECT_STORAGE_ROOT=./var/evidence
PIOS_OBJECT_STORAGE_BUCKET=pios-evidence
PIOS_S3_ENDPOINT_URL=http://minio:9000
PIOS_S3_ACCESS_KEY=pios
PIOS_S3_SECRET_KEY=pios-secret
PIOS_S3_REGION=us-east-1
PIOS_MAX_UPLOAD_SIZE_MB=25
PIOS_ANTIVIRUS_MODE=basic
PIOS_EXPORT_STORAGE_ROOT=./var/exports
PIOS_EXPORT_RETENTION_DAYS=30

# Sprint 6 deployment acceptance
PIOS_RELEASE_VERSION=1.1.0
PIOS_RELEASE_SHA=
PIOS_FRONTEND_BASE_URL=https://pios.example.sa
PIOS_DEPLOYMENT_ENVIRONMENT_CODE=tgh-pilot
PIOS_MONITORING_ENABLED=false
PIOS_TLS_ENABLED=false
PIOS_BACKUP_STORAGE_ROOT=./var/backups
PIOS_DEPLOYMENT_REPORT_ROOT=./var/deployment-reports

PIOS_BASELINE_RELEASE_ROOT=./var/baseline-releases

PIOS_GOVERNANCE_EXPORT_ROOT=./var/governance-exports
