PIOS_ENV=production
PIOS_DATABASE_URL=postgresql+psycopg://pios:CHANGE_ME@db:5432/pios
PIOS_ORGANIZATION_CODE=NBC
PIOS_DEFAULT_SITE_CODE=TGH
PIOS_AUTH_MODE=oidc
PIOS_ALLOW_DEV_TOKENS=false
PIOS_OIDC_ISSUER=https://identity.example.sa/realms/pios
PIOS_OIDC_AUDIENCE=pios-api
PIOS_OIDC_JWKS_URL=https://identity.example.sa/realms/pios/protocol/openid-connect/certs
PIOS_OIDC_ROLES_CLAIM=roles
PIOS_OIDC_SITE_CLAIM=sites
PIOS_CORS_ORIGINS=https://pios.example.sa
PIOS_OBJECT_STORAGE_BACKEND=s3
PIOS_OBJECT_STORAGE_BUCKET=pios-evidence
PIOS_S3_ENDPOINT_URL=http://minio:9000
PIOS_S3_ACCESS_KEY=pios
PIOS_S3_SECRET_KEY=CHANGE_ME
PIOS_EXPORT_STORAGE_ROOT=/app/var/exports
POSTGRES_PASSWORD=CHANGE_ME
MINIO_ROOT_USER=pios
MINIO_ROOT_PASSWORD=CHANGE_ME

PIOS_RELEASE_VERSION=0.8.0
PIOS_RELEASE_SHA=
PIOS_FRONTEND_BASE_URL=https://pios.example.sa
PIOS_DEPLOYMENT_ENVIRONMENT_CODE=tgh-pilot
PIOS_MONITORING_ENABLED=false
PIOS_TLS_ENABLED=false
PIOS_BACKUP_STORAGE_ROOT=/app/var/backups
PIOS_DEPLOYMENT_REPORT_ROOT=/app/var/deployment-reports

PIOS_BASELINE_RELEASE_ROOT=./var/baseline-releases

PIOS_GOVERNANCE_EXPORT_ROOT=./var/governance-exports
