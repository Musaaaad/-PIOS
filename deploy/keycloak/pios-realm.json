{
  "realm": "pios",
  "enabled": true,
  "displayName": "PIOS Pilot",
  "roles": {
    "realm": [
      {
        "name": "SystemAdmin"
      },
      {
        "name": "AccreditationLead"
      },
      {
        "name": "PharmacyDirector"
      },
      {
        "name": "MedicationSafety"
      },
      {
        "name": "EvidenceCollector"
      },
      {
        "name": "EvidenceReviewer"
      },
      {
        "name": "CAPAOwner"
      },
      {
        "name": "CAPAVerifier"
      },
      {
        "name": "ReadOnlyAuditor"
      }
    ]
  },
  "clients": [
    {
      "clientId": "pios-portal",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "https://pios-frontend.onrender.com/*",
        "https://musaaaad.github.io/-PIOS/*",
        "http://localhost:8080/*"
      ],
      "webOrigins": [
        "https://pios-frontend.onrender.com",
        "https://musaaaad.github.io",
        "http://localhost:8080"
      ],
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "sites",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "sites",
            "claim.value": "TGH",
            "jsonType.label": "String",
            "access.token.claim": "true"
          }
        },
        {
          "name": "pios-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "pios-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ],
      "postLogoutRedirectUris": [
        "https://pios-frontend.onrender.com/*",
        "https://musaaaad.github.io/-PIOS/*",
        "http://localhost:8080/*"
      ],
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false
    }
  ]
}